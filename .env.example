# Copy to .env, chmod 0600, and fill in the pinned image digest and token.
# Use ./deploy.sh up for initial registration or identity changes; blank
# TITAN_RUNNER_TOKEN after successful registration and run ./deploy.sh up again.
# VM network requirements: docs/vm-deployment.md

TITAN_RUNNER_IMAGE=ghcr.io/pintjesb/titan-stocks-runner@sha256:replace-with-published-digest
TITAN_RUNNER_REPO_URL=https://github.com/PintjesB/titan-stocks
TITAN_RUNNER_NAME=titan-ci
TITAN_RUNNER_LABELS=titan-ci
TITAN_RUNNER_TOKEN=

# Optional path overrides:
# TITAN_RUNNER_STATE_DIR=/var/lib/titan-runner/state
# TITAN_RUNNER_RUNTIME_DIR=/var/lib/titan-runner/runtime
# TITAN_RUNNER_WORK_DIR=/var/lib/titan-runner/work
# TITAN_RUNNER_BROWSER_DIR=/var/lib/titan-runner/browser
# TITAN_RUNNER_ROOT=/opt/actions-runner
