# Pin the deployed image by digest after the first publication.
OPORTUNIST_RUNNER_IMAGE=ghcr.io/pintjesb/oportunist-runner:latest
OPORTUNIST_RUNNER_REPO_URL=https://github.com/PintjesB/oportunist
OPORTUNIST_RUNNER_NAME=oportunist-ci
OPORTUNIST_RUNNER_LABELS=oportunist-ci,codex

# Short-lived GitHub Actions registration token. Required only for first
# registration or when runner identity changes. Blank it after registration.
OPORTUNIST_RUNNER_TOKEN=
